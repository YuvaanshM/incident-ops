# Runtime
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Local PostgreSQL only. Use a secret manager outside development.
POSTGRES_DB=incident_ops
POSTGRES_USER=incident_ops
POSTGRES_PASSWORD=incident_ops_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://incident_ops:incident_ops_local@localhost:5432/incident_ops

# Provider-neutral human authentication placeholders (selected in Phase 4)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
DEVELOPMENT_AUTH_ENABLED=false

# Scoped agent-token placeholders (implemented in Phase 7)
AGENT_TOKEN_ISSUER=
AGENT_TOKEN_AUDIENCE=
AGENT_TOKEN_SIGNING_KEY=

# External services. Keep blank until configured in later phases.
SLACK_WEBHOOK_URL=
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=

# Destructive fixture resets require both flags and are refused outside development.
ALLOW_DEVELOPMENT_RESET=false
