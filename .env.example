# Runtime
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Local PostgreSQL only. Use a secret manager outside development.
POSTGRES_DB=incident_ops
POSTGRES_USER=incident_ops
POSTGRES_PASSWORD=incident_ops_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://incident_ops:incident_ops_local@localhost:5432/incident_ops
# Integration tests derive the sibling database name `incident_ops_test`.

# Provider-neutral human authentication placeholders (selected in Phase 4)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ACTOR_TYPE_CLAIM=https://incident-ops.example/actor_type
# Set true only in an ignored local `.env` to use human-demo/agent-demo in Swagger.
DEVELOPMENT_AUTH_ENABLED=false

# Auth0 owns the hosted human browser session in production. Values stay blank in Git.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
APP_BASE_URL=http://localhost:3000

# Phase 10 browser tools: enable only with a separate issuer/audience and random server key.
AGENT_TOKENS_ENABLED=false
AGENT_TOKEN_ISSUER=
AGENT_TOKEN_AUDIENCE=
AGENT_TOKEN_SIGNING_KEY=

# Slack delivery. Keep the webhook blank until a destination is configured.
# In development, a local mock such as http://127.0.0.1:8099/mock is allowed.
SLACK_WEBHOOK_URL=
# Slack issues-channel intake (separate from the outbound webhook). Disabled by default.
# Add SLACK_INTAKE__SIGNING_SECRET only to your secret manager/ignored .env.
# See docs/phase-8-slack-intake.md for app/team/channel bindings and Slack setup.
SLACK_INTAKE__ENABLED=false
# Generic monitoring alert intake. Disabled until explicit source/service/key bindings exist.
# Add signing secrets only to your secret manager/ignored .env, never to this file.
# See docs/phase-8-generic-alerts.md for the source JSON and synthetic sender.
ALERT_INTAKE__ENABLED=false
WORKER_BATCH_SIZE=5
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
SLACK_CONNECT_TIMEOUT_SECONDS=3
SLACK_READ_TIMEOUT_SECONDS=10
SLACK_TOTAL_TIMEOUT_SECONDS=15

# Historical retrieval (Phase 11A); see docs/phase-11a-retrieval.md.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
# Offline demo: deterministic + hash-bow-v1; external: openai + text-embedding-3-small.
EMBEDDING_API_KEY=
EMBEDDING_ALLOW_EXTERNAL_PROCESSING=false

# Optional investigation; see docs/phase-11b-investigation.md.
INVESTIGATION_ENABLED=false
INVESTIGATION_API_KEY=
INVESTIGATION_MODEL=gpt-5.4-mini-2026-03-17
INVESTIGATION_SYNTHETIC_DATA_CONFIRMED=false
INVESTIGATION_EVALUATION_PASSED=false

# Destructive fixture resets require both flags and are refused outside development.
ALLOW_DEVELOPMENT_RESET=false
